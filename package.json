{
  "name": "fintech",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild:clean": "expo prebuild --clean",
    "eas:init": "npx eas-cli init",
    "build:dev": "npx eas-cli build --profile development",
    "build:dev:ios-sim": "npx eas-cli build --profile development-simulator --platform ios",
    "build:preview": "npx eas-cli build --profile preview",
    "build:production": "npx eas-cli build --profile production",
    "submit:android": "npx eas-cli submit --platform android --profile production",
    "submit:ios": "npx eas-cli submit --platform ios --profile production",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "dependencies": {
    "@clerk/expo": "^4.6.8",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/native": "^7.1.8",
    "eslint-config-expo": "~57.0.2",
    "expo": "^57.0.24",
    "expo-asset": "^57.0.18",
    "expo-build-properties": "~57.0.21",
    "expo-constants": "^57.0.19",
    "expo-dev-client": "^57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "^57.0.10",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.3.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.3",
    "react-native-country-picker-modal": "^2.0.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "private": true
}
